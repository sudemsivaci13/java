    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="str" type="String" array="False" size=""/>
            <declare name="length, i" type="Integer" array="False" size=""/>
            <output expression="&quot;String: &quot;" newline="True"/>
            <input variable="str"/>
            <assign variable="length" expression="Len(str)"/>
            <for variable="i" start="(length-1)" end="0" direction="dec" step="1">
                <output expression="Char(str,i)" newline="False"/>
            </for>
        </body>
    </function>
</flowgorithm>
