<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="project_reverse_the_word"/>
        <attribute name="authors" value="sudem"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-11 12:45:34 PM"/>
        <attribute name="created" value="c3VkZW07U1VERU0tTUFDQk9PSy1BOzIwMjUtMTItMjY7MDg6MDQ6MDIgUE07Mjg2NQ=="/>
