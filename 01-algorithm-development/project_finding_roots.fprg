<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="project_finding_roots"/>
        <attribute name="authors" value="sudem"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-11 11:52:49 AM"/>
        <attribute name="created" value="c3VkZW07U1VERU0tTUFDQk9PSy1BOzIwMjUtMTEtMjU7MTE6NDg6NDMgQU07Mjg1NQ=="/>
        <attribute name="edited" value="c3VkZW07U1VERU0tTUFDQk9PSy1BOzIwMjYtMDgtMTE7MTE6NTI6NDkgQU07MzsyOTY4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, d, x1, x2" type="Real" array="False" size=""/>
            <output expression="&quot;a:&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;b:&quot;" newline="True"/>
            <input variable="b"/>
            <output expression="&quot;c:&quot;" newline="True"/>
            <input variable="c"/>
            <assign variable="d" expression="b^2-4*a*c"/>
            <output expression="&quot;Your function is &quot; &amp;a&amp; &quot;x&#178;+&quot; &amp;b&amp; &quot;x+&quot; &amp;c&amp; &quot; and discriminant is &quot; &amp;d" newline="True"/>
            <if expression="d&lt;0">
                <then>
                    <output expression="&quot;No real roots.&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="d==0">
                        <then>
                            <assign variable="x1" expression="-b/(2*a)"/>
                            <assign variable="x2" expression="-b/(2*a)"/>
                            <output expression="&quot;There are two equal roots and these roots are: &quot; &amp;x1" newline="True"/>
                        </then>
                        <else>
                            <assign variable="x1" expression="(-b+(d^(1/2)))/(2*a)"/>
                            <assign variable="x2" expression="(-b-(d^(1/2)))/(2*a)"/>
                            <output expression="&quot;there are two roots and these roots are: &quot; &amp;x1&amp; &quot;, &quot; &amp;x2" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
